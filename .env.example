# Copy to .env and fill in. .env is git-ignored -- never commit real
# credentials. Used by `make secrets` (and `make deploy`, which calls it).
#
# Only secret values live here -- namespace, target platform, values file,
# etc. are Makefile variables (see `make help`), not duplicated here.

# Registry storing the mirrored IDIG/APIC/NanoGateway/Valkey images
# (see scripts/mirror-images.sh). Required.
REGISTRY_SERVER=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Only needed if global.ibmEntitlementKeySecret is set in your values file
# (pulling some images directly from cp.icr.io instead of your mirror).
# Leave empty to skip creating this secret.
IBM_ENTITLEMENT_KEY=

# Only needed if idigCluster.watsonxSecret is set in your values file.
# Leave both empty to skip creating this secret and leave the GenAI
# service undeployed.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
